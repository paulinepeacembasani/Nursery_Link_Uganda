# Copy to .env and fill in. Every variable is validated at startup (apps/api/src/config.ts).

# ── Core ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Reverse proxies in front of the API (0 = none). Set to 1 behind one load balancer / nginx.
TRUST_PROXY=0
# Multiplies every in-memory rate limit; keep 1 outside tests
RATE_LIMIT_SCALE=1
# Serve OpenAPI docs at /api/v1/docs
API_DOCS=true
DATABASE_URL=postgres://nurserylink:nurserylink_dev@127.0.0.1:5433/nurserylink
# Public web app and admin console origins, comma-separated
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_WEB_URL=http://localhost:5173
# Only when web and admin share a parent domain in production, e.g. .nurserylink.ug
COOKIE_DOMAIN=

# ── Secrets (generate each with: openssl rand -hex 32) ─────
JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=
QUOTE_TOKEN_SECRET=

# ── Payments: mock | live ──────────────────────────────────
# Trial switches, for trying the whole system before SMS and payments are live.
#   PHONE_VERIFICATION=off  accounts are confirmed at sign-up (no SMS code) and signed in at once
#   PAYMENTS=off            checkout has no payment step; orders are confirmed straight away as
#                           "trial" orders and payouts are recorded through the mock (no money moves).
#                           Needs PAYMENT_PROVIDER_MODE=mock.
PHONE_VERIFICATION=required
PAYMENTS=on
PAYMENT_PROVIDER_MODE=mock
# MTN MoMo Open API (https://momodeveloper.mtn.com). Sandbox: currency EUR; create the API
# users with scripts/mtn/sandbox-user.sh. Production: target environment "mtnuganda", currency UGX.
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CURRENCY=EUR
MTN_COLLECTION_SUBSCRIPTION_KEY=
MTN_COLLECTION_API_USER=
MTN_COLLECTION_API_KEY=
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_DISBURSEMENT_API_USER=
MTN_DISBURSEMENT_API_KEY=
# Optional: public URL MTN posts status callbacks to (…/api/v1/webhooks/payments/mtn_momo).
# Without it, payments are confirmed by polling (20 s, 1 min, 3 min, then the 15-minute check).
MTN_CALLBACK_URL=
# Airtel Money Open API (https://developers.airtel.africa). Not integrated yet: in live mode it
# is reported as unavailable, so these are not required.
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# ── SMS: mock | africastalking ─────────────────────────────
SMS_PROVIDER=mock
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Secret appended to the inbound-SMS callback URL: /api/v1/webhooks/sms/inbound?token=… (openssl rand -hex 24)
SMS_INBOUND_TOKEN=

# ── Public site ───────────────────────────────────────────
# First-visit notice that the nursery data is sample data (on | off)
DEMO_NOTICE=on
# Needs-assessment survey, e.g. https://docs.google.com/forms/d/e/…/viewform (blank = no survey)
SURVEY_URL=

# ── Routing: mock (haversine x 1.3) | osrm | openrouteservice ─
# OpenRouteService needs a free key: https://openrouteservice.org/dev/#/signup
ROUTING_PROVIDER=mock
OSRM_URL=http://localhost:5000
ORS_API_KEY=

# Place search by name (mock | nominatim). Nominatim's public server needs a contact (email or URL)
# in the User-Agent and allows one request per second; the API queues and caches accordingly.
GEOCODER_PROVIDER=mock
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT=

# ── Email: mock | smtp ─────────────────────────────────────
EMAIL_PROVIDER=mock
EMAIL_FROM="Nursery Link Uganda <no-reply@nurserylink.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── First administrator, created by `pnpm db:seed` ─────────
ADMIN_FULL_NAME=
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
